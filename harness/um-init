#!/bin/sh

set -u

cmdline=$(cat /proc/cmdline 2>/dev/null || true)
session=
hostfs_root=
guest_cwd=/

for argument in $cmdline; do
    case "$argument" in
        neoproot_session=*) session=${argument#neoproot_session=} ;;
        hostfs=*) hostfs_root=${argument#hostfs=} ;;
        neoproot_cwd=*) guest_cwd=${argument#neoproot_cwd=} ;;
    esac
done

mount_proc() { mount -t proc proc /proc 2>/dev/null || test -r /proc/self/status; }
mount_sys() { mount -t sysfs sysfs /sys 2>/dev/null || test -d /sys/kernel; }
mount_dev() { mount -t devtmpfs devtmpfs /dev 2>/dev/null || test -c /dev/null; }
power_down() { sync; poweroff -f; while :; do sleep 3600; done; }

if ! mount_proc || ! mount_sys || ! mount_dev; then
    printf '%s\n' 'UM_SESSION_ERROR=125'
    power_down
fi

if [ -z "$session" ]; then
    /bin/sh /um-command.sh
    rc=$?
    printf 'UM_COMMAND_EXIT=%s\n' "$rc"
    if [ "$rc" -eq 0 ]; then echo UMARM_BOOT_OK; fi
    power_down
fi

case "$hostfs_root" in
    /*) ;;
    *) printf '%s\n' 'UM_SESSION_ERROR=125'; power_down ;;
esac
case "$session" in
    /*|*..*|*,*|*' '*|*'	'*) ;;
    *) printf '%s\n' 'UM_SESSION_ERROR=125'; power_down ;;
esac
case "$guest_cwd" in
    /*|*..*|*' '*|*'	'*) ;;
    *) printf '%s\n' 'UM_SESSION_ERROR=125'; power_down ;;
esac

if [ -L /run/neoproot ]; then
    printf '%s\n' 'UM_SESSION_ERROR=125'
    power_down
fi
mkdir -p /run/neoproot || { printf '%s\n' 'UM_SESSION_ERROR=125'; power_down; }
mount none /run/neoproot -t hostfs -o "$session" 2>/dev/null || {
    printf '%s\n' 'UM_SESSION_ERROR=125'
    power_down
}
if [ ! -x /run/neoproot/init.sh ]; then
    printf '%s\n' 'UM_SESSION_ERROR=125'
    power_down
fi
cd "$guest_cwd" 2>/dev/null || {
    printf '%s\n' '126'
    printf '%s\n' 'UM_COMMAND_EXIT=126'
    power_down
}
/bin/sh /run/neoproot/init.sh
rc=$?
printf '%s\n' "$rc" > /run/neoproot/status
printf 'UM_COMMAND_EXIT=%s\n' "$rc"
if [ "$rc" -eq 0 ]; then echo UMARM_BOOT_OK; fi
power_down
